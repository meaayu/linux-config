          "label": { "color": "{{colors.primary.default.hex}}" },
          "link_text": { "color": "{{colors.primary.default.hex}}" },
          "link_uri": { "color": "{{colors.tertiary.default.hex}}" },
          "number": { "color": "{{colors.primary.default.hex}}" },
          "operator": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "predictive": { "color": "{{colors.outline.default.hex}}", "font_style": "italic" },
          "preproc": { "color": "{{colors.primary.default.hex}}" },
          "primary": { "color": "{{colors.on_surface.default.hex}}" },
          "property": { "color": "{{colors.on_surface.default.hex}}" },
          "punctuation": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "punctuation.bracket": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "punctuation.delimiter": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "punctuation.list_marker": { "color": "{{colors.primary.default.hex}}" },
          "punctuation.special": { "color": "{{colors.tertiary.default.hex}}" },
          "string": { "color": "{{colors.tertiary.default.hex}}" },
          "string.escape": { "color": "{{colors.primary_container.default.hex}}" },
          "string.regex": { "color": "{{colors.tertiary.default.hex}}" },
          "string.special": { "color": "{{colors.tertiary.default.hex}}" },
          "string.special.symbol": { "color": "{{colors.tertiary.default.hex}}" },
          "tag": { "color": "{{colors.tertiary.default.hex}}" },
          "text.literal": { "color": "{{colors.tertiary.default.hex}}" },
          "title": { "color": "{{colors.primary.default.hex}}", "font_weight": 700 },
          "type": { "color": "{{colors.tertiary.default.hex}}" },
          "type.builtin": { "color": "{{colors.tertiary.default.hex}}" },
          "variable": { "color": "{{colors.on_surface.default.hex}}" },
          "variable.builtin": { "color": "{{colors.primary_container.default.hex}}" },
          "variable.member": { "color": "{{colors.on_surface.default.hex}}" },
          "variable.parameter": { "color": "{{colors.tertiary.default.hex}}" },
          "variant": { "color": "{{colors.primary.default.hex}}" }
