          "comment.doc": { "color": "{{colors.outline.default.hex}}", "font_style": "italic" },
          "constant": { "color": "{{colors.primary.default.hex}}" },
          "constructor": { "color": "{{colors.tertiary.default.hex}}" },
          "embedded": { "color": "{{colors.on_surface.default.hex}}" },
          "emphasis": { "color": "{{colors.on_surface.default.hex}}", "font_style": "italic" },
          "emphasis.strong": { "color": "{{colors.on_surface.default.hex}}", "font_weight": 700 },
          "enum": { "color": "{{colors.primary.default.hex}}" },
          "function": { "color": "{{colors.secondary.default.hex}}" },
          "function.builtin": { "color": "{{colors.secondary.default.hex}}" },
          "hint": { "color": "{{colors.outline.default.hex}}" },
