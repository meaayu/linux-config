{
  "Console Write Line": {
    "prefix": "cw",
    "body": ["Console.WriteLine($1);"],
    "description": "Console.WriteLine"
  },
  "Console Write": {
    "prefix": "cwr",
    "body": ["Console.Write($1);"],
    "description": "Console.Write"
  },
  "Property": {
    "prefix": "prop",
    "body": ["public ${1:type} ${2:Name} { get; set; }"],
    "description": "Auto property"
  },
  "Private Property": {
    "prefix": "propp",
    "body": ["private ${1:type} ${2:_name};"],
    "description": "Private field"
  },
  "Constructor": {
    "prefix": "ctor",
    "body": ["public ${1:ClassName}(${2:params})", "{", "\t$0", "}"],
    "description": "Constructor"
  },
  "Class": {
    "prefix": "cls",
    "body": ["public class ${1:ClassName}", "{", "\t$0", "}"],
    "description": "Class definition"
  },
  "Interface": {
    "prefix": "iface",
    "body": ["public interface I${1:Name}", "{", "\t$0", "}"],
    "description": "Interface definition"
  },
  "Method": {
    "prefix": "meth",
    "body": ["public ${1:void} ${2:MethodName}(${3:params})", "{", "\t$0", "}"],
    "description": "Method definition"
  },
  "Async Method": {
    "prefix": "ameth",
    "body": [
      "public async Task${1:<T>} ${2:MethodName}(${3:params})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Async method"
  },
  "Try Catch": {
    "prefix": "try",
    "body": [
      "try",
      "{",
      "\t$1",
      "}",
      "catch (Exception ${2:ex})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Try catch block"
  },
  "If": {
    "prefix": "if",
    "body": ["if (${1:condition})", "{", "\t$0", "}"],
    "description": "If statement"
  },
  "If Else": {
    "prefix": "ife",
    "body": ["if (${1:condition})", "{", "\t$2", "}", "else", "{", "\t$0", "}"],
    "description": "If else statement"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:length}; ${1:i}++)",
      "{",
      "\t$0",
      "}"
    ],
    "description": "For loop"
  },
  "Foreach": {
    "prefix": "fore",
    "body": [
      "foreach (${1:var} ${2:item} in ${3:collection})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Foreach loop"
  },
  "While": {
    "prefix": "wh",
    "body": ["while (${1:condition})", "{", "\t$0", "}"],
    "description": "While loop"
  },
  "Switch": {
    "prefix": "sw",
    "body": [
      "switch (${1:variable})",
      "{",
      "\tcase ${2:value}:",
      "\t\t$0",
      "\t\tbreak;",
      "\tdefault:",
      "\t\tbreak;",
      "}"
    ],
    "description": "Switch statement"
  },
  "Null Check": {
    "prefix": "null",
    "body": ["if (${1:value} is null) $0"],
    "description": "Null check"
  },
  "Ternary": {
    "prefix": "ter",
    "body": ["${1:condition} ? ${2:true} : ${3:false}"],
    "description": "Ternary operator"
  },
  "Lambda": {
    "prefix": "lam",
    "body": ["${1:x} => ${2:x}"],
    "description": "Lambda expression"
  },
  "New List": {
    "prefix": "list",
    "body": ["List<${1:type}> ${2:name} = new List<${1:type}>();"],
    "description": "New List"
  },
  "New Dictionary": {
    "prefix": "dict",
    "body": [
      "Dictionary<${1:key}, ${2:value}> ${3:name} = new Dictionary<${1:key}, ${2:value}>();"
    ],
    "description": "New Dictionary"
  },
  "Var": {
    "prefix": "vr",
    "body": ["var ${1:name} = ${2:value};"],
    "description": "Var declaration"
  },
  "Using": {
    "prefix": "us",
    "body": ["using ${1:Namespace};"],
    "description": "Using statement"
  },
  "Namespace": {
    "prefix": "ns",
    "body": ["namespace ${1:MyNamespace}", "{", "\t$0", "}"],
    "description": "Namespace block"
  },
  "Region": {
    "prefix": "reg",
    "body": ["#region ${1:RegionName}", "$0", "#endregion"],
    "description": "Region block"
  },
  "Throw Exception": {
    "prefix": "thr",
    "body": ["throw new ${1:Exception}(\"${2:message}\");"],
    "description": "Throw exception"
  },
  "String Interpolation": {
    "prefix": "si",
    "body": ["$\"${1:text} {${2:variable}}\""],
    "description": "String interpolation"
  },
  "Debug Log": {
    "prefix": "dbg",
    "body": ["Debug.WriteLine($\"${1:label}: {${2:value}}\");"],
    "description": "Debug.WriteLine"
  },

  "Convert To Int": {
    "prefix": "cvint",
    "body": ["int ${1:result} = Convert.ToInt32(${2:value});"],
    "description": "Convert to int"
  },
  "Convert To Double": {
    "prefix": "cvdbl",
    "body": ["double ${1:result} = Convert.ToDouble(${2:value});"],
    "description": "Convert to double"
  },
  "Convert To Decimal": {
    "prefix": "cvdec",
    "body": ["decimal ${1:result} = Convert.ToDecimal(${2:value});"],
    "description": "Convert to decimal"
  },
  "Convert To String": {
    "prefix": "cvstr",
    "body": ["string ${1:result} = Convert.ToString(${2:value});"],
    "description": "Convert to string"
  },
  "Convert To Bool": {
    "prefix": "cvbool",
    "body": ["bool ${1:result} = Convert.ToBoolean(${2:value});"],
    "description": "Convert to bool"
  },
  "Convert To Long": {
    "prefix": "cvlong",
    "body": ["long ${1:result} = Convert.ToInt64(${2:value});"],
    "description": "Convert to long"
  },
  "Convert To Float": {
    "prefix": "cvflt",
    "body": ["float ${1:result} = Convert.ToSingle(${2:value});"],
    "description": "Convert to float"
  },
  "Explicit Cast": {
    "prefix": "cast",
    "body": ["${1:type} ${2:result} = (${1:type})${3:value};"],
    "description": "Explicit cast"
  },
  "Parse": {
    "prefix": "parse",
    "body": ["${1:int} ${2:result} = ${1:int}.Parse(${3:value});"],
    "description": "Parse string to type"
  },
  "TryParse": {
    "prefix": "tryp",
    "body": [
      "if (${1:int}.TryParse(${2:input}, out ${1:int} ${3:result}))",
      "{",
      "\t$0",
      "}",
      "else",
      "{",
      "\t// invalid input",
      "}"
    ],
    "description": "Safe TryParse with if/else"
  },
  "ToString": {
    "prefix": "tostr",
    "body": ["string ${1:result} = ${2:value}.ToString();"],
    "description": "Convert any value to string"
  },
  "Boxing": {
    "prefix": "box",
    "body": ["object ${1:boxed} = ${2:value};"],
    "description": "Box a value type into object"
  },
  "Unboxing": {
    "prefix": "unbox",
    "body": ["${1:int} ${2:result} = (${1:int})${3:boxed};"],
    "description": "Unbox an object to value type"
  }
}
